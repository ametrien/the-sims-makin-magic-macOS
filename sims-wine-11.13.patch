+
+/* The Vulkan backend has no drawable, so the ddraw primary surface never
+ * reaches the screen through the usual path. Copy it to the window DC. */
+static void swapchain_vk_frontbuffer_updated(struct wined3d_swapchain *swapchain)
+{
+    struct wined3d_texture *front_buffer = swapchain->front_buffer;
+    D3DKMT_DESTROYDCFROMMEMORY destroy_desc;
+    D3DKMT_CREATEDCFROMMEMORY create_desc;
+    unsigned int row_pitch, slice_pitch;
+    const struct wined3d_format *format;
+    struct wined3d_context *context;
+    POINT offset = {0, 0};
+    RECT draw_rect;
+    NTSTATUS status;
+    HDC src_dc;
+
+    TRACE("swapchain %p.\n", swapchain);
+
+    format = front_buffer->resource.format;
+    if (!format->ddi_format)
+    {
+        WARN("Cannot create a DC for format %s.\n", debug_d3dformat(format->id));
+        return;
+    }
+
+    context = context_acquire(swapchain->device, front_buffer, 0);
+    wined3d_texture_load_location(front_buffer, 0, context, WINED3D_LOCATION_SYSMEM);
+    wined3d_texture_get_pitch(front_buffer, 0, &row_pitch, &slice_pitch);
+
+    create_desc.pMemory = front_buffer->resource.heap_memory;
+    create_desc.Format = format->ddi_format;
+    create_desc.Width = wined3d_texture_get_level_width(front_buffer, 0);
+    create_desc.Height = wined3d_texture_get_level_height(front_buffer, 0);
+    create_desc.Pitch = row_pitch;
+    create_desc.hDeviceDc = CreateCompatibleDC(NULL);
+    create_desc.pColorTable = NULL;
+
+    status = D3DKMTCreateDCFromMemory(&create_desc);
+    DeleteDC(create_desc.hDeviceDc);
+    if (status)
+    {
+        WARN("Failed to create DC, status %#lx.\n", status);
+        context_release(context);
+        return;
+    }
+    src_dc = create_desc.hDc;
+
+    if (swapchain->state.desc.windowed)
+        ClientToScreen(swapchain->win_handle, &offset);
+
+    SetRect(&draw_rect, 0, 0, front_buffer->resource.width, front_buffer->resource.height);
+    if (!IsRectEmpty(&swapchain->front_buffer_update))
+        IntersectRect(&draw_rect, &draw_rect, &swapchain->front_buffer_update);
+
+    if (!BitBlt(swapchain->dc, draw_rect.left - offset.x, draw_rect.top - offset.y,
+            draw_rect.right - draw_rect.left, draw_rect.bottom - draw_rect.top,
+            src_dc, draw_rect.left, draw_rect.top, SRCCOPY))
+        ERR("Failed to blit the front buffer.\n");
+
+    destroy_desc.hDc = src_dc;
+    destroy_desc.hBitmap = create_desc.hBitmap;
+    if ((status = D3DKMTDestroyDCFromMemory(&destroy_desc)))
+        ERR("Failed to destroy src dc, status %#lx.\n", status);
+
+    SetRectEmpty(&swapchain->front_buffer_update);
+    context_release(context);
 }
 
