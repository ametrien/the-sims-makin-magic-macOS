-    wined3d_texture_invalidate_location(swapchain->front_buffer, 0, ~WINED3D_LOCATION_DRAWABLE);
+    /* The Vulkan backend has no drawable; the front buffer content lives in
+     * its texture. Claiming DRAWABLE here leaves the resource without any
+     * valid location, breaking ddraw primary surface blits. */
+    wined3d_texture_validate_location(swapchain->front_buffer, 0, WINED3D_LOCATION_TEXTURE_RGB);
+    wined3d_texture_invalidate_location(swapchain->front_buffer, 0, ~WINED3D_LOCATION_TEXTURE_RGB);
 
